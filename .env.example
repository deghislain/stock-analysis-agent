# ─────────────────────────────────────────────────────────────────────────────
# Stock Analysis Agent — Environment Variables
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# .env is git-ignored and never committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq LLM ──────────────────────────────────────────────────────────────────
# Required for AI-generated plain-language report summaries.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. llama3-8b-8192 is fast and free-tier friendly.
# Other options: llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama3-8b-8192

# ── Application ───────────────────────────────────────────────────────────────
# Set to true for verbose logging and detailed error responses.
# Never set DEBUG=true in a public deployment.
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# In development: keep the defaults below.
# In production (Docker Compose): set to http://localhost:5173 or your domain.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── PDF output ────────────────────────────────────────────────────────────────
# Directory where generated PDF reports are stored temporarily.
# The cleanup task deletes files older than 1 hour every 30 minutes.
# When running via Docker Compose this is overridden to /app/pdf_reports
# (a named volume) — you only need to change this for local bare-metal runs.
PDF_OUTPUT_DIR=/tmp/stock_reports

# ── Data cache ────────────────────────────────────────────────────────────────
# How long (seconds) fetched stock data is cached before re-fetching.
# Default 300 (5 minutes) keeps repeated requests fast without going stale.
DATA_CACHE_TTL_SECONDS=300
