# ─────────────────────────────────────────────────────────────────────────────
# Stock Analysis Agent — Environment Variables
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in the required values (marked ★ REQUIRED below).
# 3. Never commit .env — it is listed in .gitignore.
#
# When running via Docker Compose:
#   • All variables here are loaded into the backend container automatically.
#   • PDF_OUTPUT_DIR is already overridden by docker-compose.yml — you do not
#     need to change it for a Compose run.
#   • CORS_ORIGINS defaults cover the Compose frontend (port 5173) — change
#     only if you expose the backend on a different domain.
# ─────────────────────────────────────────────────────────────────────────────


# ── Groq LLM ──────────────────────────────────────────────────────────────────
# ★ REQUIRED — AI-generated plain-language report summaries will not work
#   without this key.  Get a free key (no credit card) at https://console.groq.com

GROQ_API_KEY=your_groq_api_key_here

# Model to use for report generation.  llama3-8b-8192 is fast and free-tier
# friendly.  Other options: llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama3-8b-8192


# ── Financial Modeling Prep (FMP) ─────────────────────────────────────────────
# Optional but recommended.  Used as the fundamentals fallback source when
# Yahoo Finance cannot supply company info (P/E ratio, market cap, sector …).
# FMP requires a key even for the free tier — registration takes ~30 seconds,
# no credit card.  Get your free key at https://financialmodelingprep.com/developer/docs
# If left empty the FMP source is skipped and a warning is shown in the report.

FMP_API_KEY=


# ── Application ───────────────────────────────────────────────────────────────
# Set to true for verbose logging and detailed error responses.
# ⚠ Never set DEBUG=true in a public deployment — it exposes internal details.

DEBUG=false

# Human-readable name shown in logs and the FastAPI /docs page.
# APP_NAME=Stock Analysis Agent


# ── CORS ──────────────────────────────────────────────────────────────────────
# JSON array of frontend origins allowed to call the API.
# The defaults cover local development (Vite dev server) and the Docker Compose
# frontend container (nginx on port 5173).
# In production change this to your actual domain, e.g.:
#   CORS_ORIGINS=["https://stocks.example.com"]

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]


# ── PDF output ────────────────────────────────────────────────────────────────
# Directory where generated PDF reports are stored temporarily.
# The background cleanup task deletes files older than PDF_MAX_AGE_SECONDS
# every PDF_CLEANUP_INTERVAL_SECONDS seconds.
#
# Docker Compose: docker-compose.yml overrides this to /app/pdf_reports (a
# named volume) via the environment: block — you do NOT need to change this
# value for a Compose run.
# Bare-metal: change to any writable path, e.g. /tmp/stock_reports (default).

PDF_OUTPUT_DIR=/tmp/stock_reports

# How often (seconds) the cleanup task wakes up to scan for old PDFs.
# Default: 1800 (30 minutes)
# PDF_CLEANUP_INTERVAL_SECONDS=1800

# Maximum age (seconds) a PDF file is kept before being deleted by the cleanup
# task.  Default: 3600 (1 hour).
# PDF_MAX_AGE_SECONDS=3600


# ── Data cache ────────────────────────────────────────────────────────────────
# How long (seconds) fetched stock data is held in the in-memory cache before
# being re-fetched from the source.  Keeps repeated requests for the same
# ticker fast without going stale.  Default: 300 (5 minutes).

DATA_CACHE_TTL_SECONDS=300


# ── Portfolio / persistence ───────────────────────────────────────────────────
# SQLAlchemy database URL for the portfolio persistence layer.
# The default is a local SQLite file (portfolios.db) in the working directory —
# fine for bare-metal development runs.
#
# Docker Compose: docker-compose.yml overrides this to
#   sqlite:////app/data/portfolios.db  (a named volume, four slashes = absolute path)
# via the environment: block — you do NOT need to change this value for a
# Compose run.
#
# To use a different location on bare metal, change the path after the third
# slash, e.g.:
#   DATABASE_URL=sqlite:///./portfolios.db          (relative, default)
#   DATABASE_URL=sqlite:////home/user/portfolios.db (absolute)

DATABASE_URL=sqlite:///./portfolios.db

# Enable or disable the APScheduler quarterly refresh job.
# When true (default), the scheduler automatically re-analyses every stock in
# every portfolio at 07:00 UTC on 2 Jan, 2 Apr, 2 Jul, and 2 Oct.
# Set to false during development or testing to prevent background analysis
# jobs from firing automatically.

QUARTERLY_REFRESH_ENABLED=true
